# ===== ตั้งค่าแดชบอร์ดน้ำฝน ศรีราชา =====
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามจริง (เปิดใช้ทีละส่วนก็ได้)

PORT=8080

# ----- ตำแหน่งสวนอุตสาหกรรม -----
PARK_NAME=สวนอุตสาหกรรมเครือสหพัฒน์ ศรีราชา
PARK_LAT=13.0833
PARK_LON=100.9667

# ใส่ URL จริงของระบบเมื่อนำขึ้นเซิร์ฟเวอร์ (ใช้ในข้อความแจ้งเตือน)
# DASHBOARD_URL=http://localhost:8080

# ----- ความถี่ดึงข้อมูล (มิลลิวินาที) -----
REFRESH_TMD_MS=300000
REFRESH_METEO_MS=600000
REFRESH_RADAR_MS=180000

# ----- กรมอุตุนิยมวิทยา (TMD API) -----
# ค่า demo ใช้ได้ทันที จำกัดการเรียก — ลงทะเบียนคีย์จริงที่ https://data.tmd.go.th/
TMD_UID=demo
TMD_UKEY=demokey

# ----- กรมทรัพยากรน้ำ (ตัวเลือกเสริม กรอกเมื่อลงทะเบียนแล้ว) -----
# DWR_API_KEY=
# EWS_UID=
# EWS_PASS=

# ===== ข้อมูลเซนเซอร์ภายใน (เลือกช่องทางที่จะใช้ เปิดทีหลังได้) =====

# delta   = ค่าฝนของช่วงเวลานั้น (มม./ครั้ง)   ← ค่าเริ่มต้น
# cumulative = ตัวเลขค่าสะสมเดินหน้า (ระบบแปลงเป็น delta ให้เอง)
INTERNAL_MODE=delta

# ถ้าต้องการให้ API รับข้อมูลต้องมี token (ส่ง header: x-internal-token)
# INTERNAL_TOKEN=

# นาทีที่ถือว่าเซนเซอร์ขาดสัญญาณ (ใช้ในกฎแจ้งเตือน)
INTERNAL_STALE_MINUTES=15

# แสดงข้อมูลจำลองเมื่อยังไม่มีข้อมูลจริง (true/false)
INTERNAL_DEMO_WHEN_EMPTY=true

# ----- MQTT (กรอกเมื่อพร้อมใช้งาน — ปล่อยว่างไว้ = ปิดเงียบ) -----
# MQTT_BROKER=mqtt://192.168.1.10:1883
# MQTT_TOPIC=rain/sriracha/gauge1
# MQTT_USERNAME=
# MQTT_PASSWORD=
# ตำแหน่งค่าฝนใน payload JSON เช่น mm, data.rainfall
MQTT_FIELD_PATH=mm
MQTT_TIMESTAMP_FIELD=timestamp

# ===== การแจ้งเตือน (เปิดใช้ภายหลังได้) =====

# กันสแปม: อย่างน้อยกี่นาทีต่อครั้ง ต่อชุดเหตุการณ์
NOTIFY_COOLDOWN_MIN=60

# ----- ช่องทาง LINE (LINE Messaging API — LINE Notify ยุติบริการแล้ว) -----
# 1) สร้าง LINE Official Account แล้วเปิด Messaging API ที่ https://developers.line.biz/
# 2) สร้าง Channel Access Token (long-lived)
# 3) เพิ่มเพื่อน/สร้างกลุ่ม แล้วเอา userId/groupId มาใส่ (คั่นด้วย ,)
LINE_ENABLED=false
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO=

# ----- ช่องทางอีเมล (SMTP) -----
# Gmail: smtp.gmail.com 587 + App Password
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL_TO=
